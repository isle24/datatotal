{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traffic Lens",
  "version": "0.1.0",
  "identifier": "cn.isle.traffic-lens",
  "build": {
    "beforeBuildCommand": "npm --prefix ../../front-end run build:desktop",
    "beforeDevCommand": "npm --prefix ../../front-end run dev:desktop",
    "devUrl": "http://localhost:1420/desktop.html",
    "frontendDist": "../../../front-end/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Traffic Lens",
        "url": "desktop.html",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "shortDescription": "Local system monitoring and NAS dashboard",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
