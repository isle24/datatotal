{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "build:desktop": "vite build --mode desktop",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:dev": "cd ../server/desktop/app && tauri dev",
    "desktop:build": "cd ../server/desktop/app && tauri build",
    "desktop:mac": "npm run desktop:build -- --bundles app && node ../scripts/package-macos.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.20.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "echarts": "^6.1.0",
    "vite": "^8.0.16",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
